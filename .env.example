# Local MVP environment template
# Copy to .env.local (gitignored), fill in values, then run `pnpm dev`.
# Do not commit real secrets.

# --- Postgres (matches docker compose defaults; run `pnpm db:up`) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/selecta

# --- Neo4j (matches docker compose defaults; run `pnpm db:up`) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- External music catalog (server-only; Spotify Web API client credentials) ---
# Create an app at https://developer.spotify.com/dashboard — never expose these to the browser.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Optional ISO 3166-1 alpha-2 market for search (default US; required for client-credentials results)
# SPOTIFY_MARKET=US

# --- AI (Vercel AI Gateway or equivalent) ---
AI_GATEWAY_API_KEY=

# --- Local single-tenant stub (until auth lands) ---
DEV_LIBRARY_ID=dev-library
DEV_USER_ID=dev-user

# --- Local apps ---
# API origin used by web Next.js rewrites (/backend → API)
API_ORIGIN=http://localhost:3001

# --- Auth (optional placeholders; not required for local MVP) ---
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
