{
  "name": "selecta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-stack.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:apps": "pnpm run --parallel --filter @selecta/web --filter @selecta/api dev",
    "dev:web": "pnpm --filter @selecta/web dev",
    "dev:api": "pnpm --filter @selecta/api dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @selecta/db db:generate",
    "db:migrate": "pnpm --filter @selecta/db db:migrate",
    "db:test:prepare": "pnpm --filter @selecta/db db:test:prepare",
    "db:studio": "pnpm --filter @selecta/db db:studio",
    "build": "pnpm run --filter @selecta/web --filter @selecta/api build",
    "lint": "pnpm run --recursive --filter '!@selecta/eslint-config' lint",
    "typecheck": "pnpm run --recursive --filter '!@selecta/eslint-config' typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0"
  },
  "packageManager": "pnpm@11.18.0"
}
